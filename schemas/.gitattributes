
# Normalize text files to Unix/LF line endings in the repo
* text=auto

*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.mk text eol=lf
*.options text eol=lf
*.proto text eol=lf
*.sh text eol=lf
Makefile text eol=lf

# Keep binary/generated protobuf artifacts binary if present
*.binpb binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
