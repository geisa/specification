{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copyright 2025-2026, Contributors to the Grid Edge Interoperability & Security Alliance (GEISA), a Series of LF Projects, LLC. Licensed under the Apache License, Version 2.0. See LICENSE.",
  "title": "GEISA Platform Discovery v0.9",
  "description": "Canonical structure for GEISA Platform Discovery request and response messages.",
  "$defs": {
    "deviceType": {
      "type": "string",
      "description": "GEISA-defined platform or module device type",
      "enum": [
        "electric-meter",
        "metrology-processor",
        "compute-card",
        "network-card",
        "coprocessor-card",
        "custom"
      ]
    },
    "waveformSampleType": {
      "type": "string",
      "description": "Waveform sample encoding used in waveform frames.",
      "enum": [
        "int16",
        "int32",
        "float32",
        "float64"
      ]
    },
    "networkClass": {
      "type": "string",
      "description": "Logical app-facing network class for this descriptor.",
      "enum": [
        "unspecified",
        "operator",
        "internet",
        "local",
        "other"
      ]
    },
    "networkOwner": {
      "type": "string",
      "description": "Administrative ownership domain for the network capability; NOT app permissions",
      "enum": [
        "unspecified",
        "operator",
        "consumer",
        "third-party",
        "shared",
        "other"
      ]
    },
    "networkTechnology": {
      "type": "string",
      "description": "Broad media/transport family for this network capability.",
      "enum": [
        "unspecified",
        "rf-mesh",
        "cellular",
        "ethernet",
        "fiber",
        "wifi",
        "other"
      ]
    },
    "networkInterface": {
      "type": "object",
      "required": [
        "interface-id",
        "network-class",
        "owner",
        "technology",
        "supports-ipv4",
        "supports-ipv6"
      ],
      "properties": {
        "interface-id": {
          "description": "Platform-local identifier for this network capability descriptor.",
          "type": "string",
          "minLength": 1
        },
        "network-class": {
          "$ref": "#/$defs/networkClass"
        },
        "owner": {
          "$ref": "#/$defs/networkOwner"
        },
        "technology": {
          "$ref": "#/$defs/networkTechnology"
        },
        "supports-ipv4": {
          "description": "Static support capability for IPv4.",
          "type": "boolean"
        },
        "supports-ipv6": {
          "description": "Static support capability for IPv6.",
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "networkInfo": {
      "type": "object",
      "description": "Static/semi-static network capability descriptors. Runtime state is reported through Platform/App Status; app permission/policy is defined in Deployment Manifest.",
      "properties": {
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/networkInterface"
          }
        }
      },
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "required": [
        "type",
        "manufacturer",
        "model"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/deviceType"
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "serial-number": {
          "type": "string",
          "minLength": 1
        },
        "hw-revision": {
          "type": "string",
          "minLength": 1
        },
        "fw-revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "geisaInfo": {
      "type": "object",
      "required": [
        "ver-major",
        "ver-minor",
        "ver-rev",
        "pillar-adm",
        "pillar-api",
        "pillar-lee",
        "pillar-vee"
      ],
      "properties": {
        "ver-major": {
          "type": "integer",
          "minimum": 0
        },
        "ver-minor": {
          "type": "integer",
          "minimum": 0
        },
        "ver-rev": {
          "type": "integer",
          "minimum": 0
        },
        "pillar-adm": {
          "type": "boolean"
        },
        "pillar-api": {
          "type": "boolean"
        },
        "pillar-lee": {
          "type": "boolean"
        },
        "pillar-vee": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "geisaStatus": {
      "type": "object",
      "description": "Generic GEISA response status aligned to geisa-status.proto.",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "GEISA status code enum name (e.g. GEISA_STATUS_SUCCESS ...)."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable status message"
        },
        "details": {
          "type": "string",
          "minLength": 1,
          "description": "Optional additional details"
        }
      },
      "additionalProperties": false
    },
    "deviceInfo": {
      "type": "object",
      "required": [
        "top-module"
      ],
      "properties": {
        "top-module": {
          "$ref": "#/$defs/module"
        },
        "sub-modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          }
        }
      },
      "additionalProperties": false
    },
    "operatorInfo": {
      "type": "object",
      "properties": {
        "operator-name": {
          "type": "string",
          "minLength": 1
        },
        "operator-identifier": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "metrologyInfo": {
      "type": "object",
      "required": [
        "meter-rating-class",
        "meter-form",
        "phase-count",
        "neutral-connected",
        "nominal-frequency-hz"
      ],
      "properties": {
        "meter-rating-class": {
          "type": "string",
          "minLength": 1
        },
        "meter-form": {
          "type": "string",
          "minLength": 1
        },
        "phase-count": {
          "type": "integer",
          "minimum": 1
        },
        "neutral-connected": {
          "type": "boolean"
        },
        "nominal-phase-angle-deg": {
          "type": "number"
        },
        "nominal-frequency-hz": {
          "type": "integer",
          "minimum": 1
        },
        "nominal-phase-to-phase-voltage-v": {
          "type": "number"
        },
        "nominal-phase-to-neutral-voltage-v": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "waveformInstance": {
      "type": "object",
      "required": [
        "stream-id",
        "sample-type",
        "voltage-channel-count",
        "current-channel-count",
        "other-channel-count",
        "total-channel-count",
        "cycle-aligned",
        "zero-crossing-aligned",
        "sample-rate-hz",
        "samples-per-cycle",
        "nominal-frequency-hz",
        "expected-frame-period-ms"
      ],
      "properties": {
        "stream-id": {
          "description": "Waveform stream identifier. Platforms that support waveform SHALL expose 'waveform-base'. Platforms MAY expose additional stream identifiers for alternate waveform views. Applications SHALL use waveform metadata to interpret a stream and SHALL NOT parse stream-id.",
          "type": "string",
          "minLength": 1
        },
        "name": {
          "description": "Optional platform-supplied display name. Informational only and not for application logic.",
          "type": "string",
          "minLength": 1
        },
        "description": {
          "description": "Optional platform-supplied human-readable description. Informational only and not for application logic.",
          "type": "string",
          "minLength": 1
        },
        "sample-type": {
          "$ref": "#/$defs/waveformSampleType"
        },
        "voltage-scale": {
          "description": "Scaling factor applied to integer voltage samples to convert raw sample values to volts. For float32 and float64, this SHOULD be omitted or set to 1.0.",
          "type": "number"
        },
        "current-scale": {
          "description": "Scaling factor applied to integer current samples to convert raw sample values to amperes. For float32 and float64, this SHOULD be omitted or set to 1.0.",
          "type": "number"
        },
        "voltage-channel-count": {
          "type": "integer",
          "minimum": 0
        },
        "current-channel-count": {
          "type": "integer",
          "minimum": 0
        },
        "other-channel-count": {
          "description": "Number of additional non-voltage, non-current channels, if present.",
          "type": "integer",
          "minimum": 0
        },
        "total-channel-count": {
          "description": "Total number of channels per sample. This SHALL equal voltage-channel-count + current-channel-count + other-channel-count.",
          "type": "integer",
          "minimum": 1
        },
        "cycle-aligned": {
          "type": "boolean"
        },
        "zero-crossing-aligned": {
          "type": "boolean"
        },
        "sample-rate-hz": {
          "description": "Sampling rate in hertz.",
          "type": "integer",
          "minimum": 1
        },
        "samples-per-cycle": {
          "description": "Discrete nominal samples-per-cycle count when applicable. For baseline waveform-base streams, this SHALL be at least 128 where AC cycle semantics apply. Sample-rate is the authoritative samples-per-second value. A value of 0 indicates not applicable or not provided.",
          "type": "integer",
          "minimum": 0
        },
        "nominal-frequency-hz": {
          "type": "integer",
          "minimum": 1
        },
        "expected-frame-period-ms": {
          "type": "integer",
          "minimum": 1
        },
        "voltage-filter-lowpass": {
          "type": "integer",
          "minimum": 0
        },
        "voltage-filter-highpass": {
          "type": "integer",
          "minimum": 0
        },
        "current-filter-lowpass": {
          "type": "integer",
          "minimum": 0
        },
        "current-filter-highpass": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "waveformInfo": {
      "type": "object",
      "properties": {
        "streams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/waveformInstance"
          }
        }
      },
      "additionalProperties": false
    },
    "platformDiscoveryResponse": {
      "type": "object",
      "required": [
        "status",
        "geisa",
        "device"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/geisaStatus"
        },
        "geisa": {
          "$ref": "#/$defs/geisaInfo"
        },
        "device": {
          "$ref": "#/$defs/deviceInfo"
        },
        "operator": {
          "$ref": "#/$defs/operatorInfo"
        },
        "metrology": {
          "$ref": "#/$defs/metrologyInfo"
        },
        "sensor": {
          "type": "object",
          "properties": {
            "sensors": {
              "type": "array",
              "items": {
                "$ref": "geisa-sensor-schema.json#/$defs/sensorDescriptor"
              }
            }
          },
          "additionalProperties": false
        },
        "network": {
          "$ref": "#/$defs/networkInfo"
        },
        "waveform": {
          "$ref": "#/$defs/waveformInfo"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "oneOf": [
    {
      "required": [
        "geisa-platform-discovery-req"
      ],
      "properties": {
        "geisa-platform-discovery-req": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "required": [
        "geisa-platform-discovery-rsp"
      ],
      "properties": {
        "geisa-platform-discovery-rsp": {
          "$ref": "#/$defs/platformDiscoveryResponse"
        }
      },
      "additionalProperties": false
    }
  ]
}
