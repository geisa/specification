{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copyright 2025-2026, Contributors to the Grid Edge Interoperability & Security Alliance (GEISA), a Series of LF Projects, LLC. Licensed under the Apache License, Version 2.0. See LICENSE.",
  "title": "GEISA Sensor v0.9.0",
  "description": "Canonical structure for GEISA sensor descriptor, read request, single reading, and read response messages aligned to sensor.proto.",
  "$defs": {
    "geisaSensorType": {
      "type": "string",
      "description": "GEISA-defined sensor type for interoperability.",
      "enum": [
        "GEISA_SENSOR_TYPE_UNSPECIFIED",
        "GEISA_SENSOR_TYPE_TEMPERATURE",
        "GEISA_SENSOR_TYPE_HUMIDITY",
        "GEISA_SENSOR_TYPE_PRESSURE",
        "GEISA_SENSOR_TYPE_VOLTAGE",
        "GEISA_SENSOR_TYPE_CURRENT",
        "GEISA_SENSOR_TYPE_POWER",
        "GEISA_SENSOR_TYPE_ENERGY",
        "GEISA_SENSOR_TYPE_CONTACT_STATE",
        "GEISA_SENSOR_TYPE_TAMPER",
        "GEISA_SENSOR_TYPE_TILT",
        "GEISA_SENSOR_TYPE_VIBRATION",
        "GEISA_SENSOR_TYPE_GEOLOCATION",
        "GEISA_SENSOR_TYPE_MICRO_ARC",
        "GEISA_SENSOR_TYPE_SEISMIC",
        "GEISA_SENSOR_TYPE_CUSTOM"
      ]
    },
    "geisaStatus": {
      "type": "string",
      "description": "GEISA status enum string as defined in the status protobuf/schema set.",
      "minLength": 1
    },
    "geolocation": {
      "type": "object",
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitude-m": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "sensorValue": {
      "type": "object",
      "description": "One scalar value entry within a reading. A reading may contain one or more values.",
      "properties": {
        "double-value": {
          "type": "number"
        },
        "int64-value": {
          "type": "integer"
        },
        "bool-value": {
          "type": "boolean"
        },
        "string-value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "double-value"
          ]
        },
        {
          "required": [
            "int64-value"
          ]
        },
        {
          "required": [
            "bool-value"
          ]
        },
        {
          "required": [
            "string-value"
          ]
        }
      ]
    },
    "sensorDescriptor": {
      "type": "object",
      "required": [
        "sensor-id",
        "sensor-type",
        "unit",
        "supports-read",
        "supports-publish"
      ],
      "properties": {
        "sensor-id": {
          "description": "Platform-local unique identifier for the sensor.",
          "type": "string",
          "minLength": 1
        },
        "sensor-type": {
          "$ref": "#/$defs/geisaSensorType"
        },
        "sensor-subtype": {
          "type": "string",
          "minLength": 1
        },
        "custom-sensor-type": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "geolocation": {
          "$ref": "#/$defs/geolocation"
        },
        "unit": {
          "description": "Engineering unit used for reported values. For multi-value readings, applies only when all values share the same unit. Where an applicable IANA SenML unit symbol exists, use the SenML unit symbol.",
          "type": "string",
          "minLength": 1
        },
        "supports-read": {
          "type": "boolean"
        },
        "supports-publish": {
          "type": "boolean"
        },
        "min-report-period-ms": {
          "type": "integer",
          "minimum": 0
        },
        "max-report-period-ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "sensor-type": {
                "const": "GEISA_SENSOR_TYPE_CUSTOM"
              }
            },
            "required": [
              "sensor-type"
            ]
          },
          "then": {
            "required": [
              "custom-sensor-type"
            ]
          }
        }
      ]
    },
    "sensorReading": {
      "type": "object",
      "required": [
        "sensor-id",
        "timestamp-ms",
        "values"
      ],
      "properties": {
        "sensor-id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp-ms": {
          "description": "UTC epoch time in milliseconds indicating when the reading was generated.",
          "type": "integer",
          "minimum": 0
        },
        "values": {
          "description": "One or more scalar values for this observation.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sensorValue"
          }
        },
        "unit": {
          "description": "Optional unit override for this reading. For multi-value readings, use only when all values share the same unit. Where an applicable IANA SenML unit symbol exists, use the SenML unit symbol.",
          "type": "string",
          "minLength": 1
        },
        "quality": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "geisa-sensor"
      ],
      "properties": {
        "geisa-sensor": {
          "type": "object",
          "required": [
            "sensor"
          ],
          "properties": {
            "sensor": {
              "$ref": "#/$defs/sensorDescriptor"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "geisa-sensor-reading"
      ],
      "properties": {
        "geisa-sensor-reading": {
          "$ref": "#/$defs/sensorReading"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "geisa-sensor-readings-req"
      ],
      "properties": {
        "geisa-sensor-readings-req": {
          "type": "object",
          "properties": {
            "sensor-id": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "geisa-sensor-readings-rsp"
      ],
      "properties": {
        "geisa-sensor-readings-rsp": {
          "type": "object",
          "required": [
            "status",
            "readings"
          ],
          "properties": {
            "status": {
              "$ref": "#/$defs/geisaStatus"
            },
            "readings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sensorReading"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
